#!/bin/sh
#
# Removes SSHush from this server.
#
# Runs as root, either from sshush-uninstall.service (triggered by
# sshush-uninstall.path when /var/lib/sshush/uninstall appears) or invoked
# directly by an administrator. Both routes must work.
#
# SECURITY: every path below is a hardcoded absolute literal. No path, name, or
# argument is ever derived from the marker file, the environment, or any
# argument passed to this script. The marker's CONTENT is used for exactly one
# thing: an equality comparison against this install's own agent_id (below),
# which can only make this script do LESS - a mismatch removes the marker and
# exits without uninstalling. So an attacker who fully controls the agent can
# still do nothing worse than uninstall it. If you are editing this script,
# that property is a requirement, not a stylistic preference.
#
# THE SCOPE CHECK: a marker may carry the agent_id its teardown was issued
# for. The app's disable flow can run on a device whose view of this server is
# STALE (CloudKit-synced state), and an unscoped marker let such a device
# uninstall a fresh agent another device had just installed - the newer
# enrolment's backend row then pushed spurious no-heartbeat alerts for ever.
# Empty marker = unscoped (older app builds): proceed, as always.
#
# There is deliberately no `set -e`. Every step has to tolerate its target
# already being gone, so that a partially-completed previous run can be finished
# simply by running this again.

step() {
	echo "sshush-uninstall: $*"
}

if [ "$(id -u)" -ne 0 ]; then
	echo "sshush-uninstall: must run as root (try: sudo /usr/local/bin/sshush-uninstall)" >&2
	exit 1
fi

# The scope check runs BEFORE anything is touched. Only applies when the
# marker exists (a hand-run by an administrator carries no marker and always
# proceeds). Reads are bounded and the content is never interpolated anywhere.
MARKER=/var/lib/sshush/uninstall
if [ -f "$MARKER" ]; then
	marker_id=$(head -c 64 "$MARKER" 2>/dev/null | tr -d '[:space:]')
	if [ -n "$marker_id" ] && [ -f /etc/sshush/config.json ]; then
		own_id=$(sed -n 's/.*"agent_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /etc/sshush/config.json 2>/dev/null | head -n 1)
		if [ -n "$own_id" ] && [ "$marker_id" != "$own_id" ]; then
			step "marker is scoped to a different agent; ignoring it"
			rm -f "$MARKER"
			exit 0
		fi
	fi
fi

step "removing SSHush"

# 1. The watcher goes first, so that a marker surviving anything below cannot
#    re-trigger this script.
step "1/9 disabling the uninstall watcher"
systemctl stop sshush-uninstall.path >/dev/null 2>&1 || :
systemctl disable sshush-uninstall.path >/dev/null 2>&1 || :

step "2/9 stopping and disabling the agent"
systemctl stop sshush-agent.service >/dev/null 2>&1 || :
systemctl disable sshush-agent.service >/dev/null 2>&1 || :

step "3/9 removing the agent and watcher unit files"
rm -f /etc/systemd/system/sshush-agent.service
rm -f /etc/systemd/system/sshush-uninstall.path

step "4/9 removing configuration and state"
rm -rf /etc/sshush
rm -rf /var/lib/sshush

step "5/9 removing the agent binary"
rm -f /usr/local/bin/sshush-agent

step "6/9 removing the sshush user and group"
if id -u sshush >/dev/null 2>&1; then
	userdel sshush >/dev/null 2>&1 ||
		echo "sshush-uninstall: userdel failed; remove the sshush user by hand" >&2
else
	step "      sshush user already absent"
fi
# install.sh creates the group explicitly, so remove it explicitly. userdel only
# reaps the primary group on some distros. Fails harmlessly if it is already gone
# or still has members.
groupdel sshush >/dev/null 2>&1 || :

# 7. This is the unit file for the service currently executing. systemd has
#    already loaded it; removing it now is safe.
step "7/9 removing the uninstall unit file (the one running this)"
rm -f /etc/systemd/system/sshush-uninstall.service

step "8/9 reloading systemd"
systemctl daemon-reload >/dev/null 2>&1 || :
# Without this, removed units can linger in `systemctl --failed`.
systemctl reset-failed sshush-agent.service sshush-uninstall.service sshush-uninstall.path >/dev/null 2>&1 || :

step "9/9 removing this script"
step "done - SSHush has been removed"

# LAST LINE. Self-deletion: /bin/sh reads this script through an open file
# descriptor, and unlinking a file whose fd is still open leaves the inode alive
# on Linux, so the running shell is unaffected. Nothing may follow this.
#
# The `|| :` is not about tolerating a missing file - rm -f already returns 0 for
# that. It is because this is the last command, so its status becomes the script's
# exit status, and a non-zero one (a read-only /usr mount, say) would leave
# sshush-uninstall.service sitting in `systemctl --failed` after a removal that
# otherwise succeeded.
rm -f /usr/local/bin/sshush-uninstall || :
